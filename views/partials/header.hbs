<header class="header">
  <div class="container">
    <nav class="navbar">
      <a href="/" class="logo">
            <img src="/images/logo-dark.svg" alt="dev Logo" class="logo-img" width="130" height="50"> 
        <span class="logo-text">TVinhhh</span>
      </a>

      <div class="btn-group">
        <button class="theme-btn" aria-label="Chuyển chế độ sáng/tối" id="themeToggle">
          <ion-icon name="moon" class="moon"></ion-icon>
          <ion-icon name="sunny" class="sun"></ion-icon>
        </button>
        <button class="nav-menu-btn" aria-label="Mở menu" id="navMenuBtn">
          <ion-icon name="menu-outline"></ion-icon>
        </button>
      </div>

      <div class="flex-wrapper" id="navMenu">
        <ul class="desktop-nav">
          <li><a href="/" class="nav-link">Trang chủ</a></li>
          <li><a href="/posts" class="nav-link">Bài viết</a></li>
          <li><a href="/topics" class="nav-link">Chủ đề</a></li>
          <li class="nav-item-contact">
            <button type="button" class="contact-trigger" id="contactTriggerDesktop" aria-expanded="false" aria-controls="contactPanelDesktop">
              Liên hệ
              <ion-icon name="chevron-down-outline" class="contact-trigger-icon"></ion-icon>
            </button>
            <div class="contact-dropdown" id="contactPanelDesktop">
              <p class="contact-dropdown-item"><ion-icon name="mail-outline"></ion-icon> thevinh251008@gmail.com</p>
              <p class="contact-dropdown-item"><ion-icon name="call-outline"></ion-icon> 0398857036</p>
              <div class="contact-dropdown-social">
                <a href="https://www.facebook.com/" aria-label="Facebook"><ion-icon name="logo-facebook"></ion-icon></a>
                <a href="https://x.com/?" aria-label="Twitter"><ion-icon name="logo-twitter"></ion-icon></a>
                <a href="https://www.instagram.com/" aria-label="Instagram"><ion-icon name="logo-instagram"></ion-icon></a>
                <a href="https://github.com/" aria-label="GitHub"><ion-icon name="logo-github"></ion-icon></a>
              </div>
              <a href="/contact" class="contact-dropdown-more">Xem trang liên hệ đầy đủ →</a>
            </div>
          </li>
        </ul>

        <div class="auth-btns">
          {{#if user}}
            <span class="user-greeting">👋 {{user.fullName}}</span>
            <a href="/dashboard/my-blogs" class="btn btn-secondary">My blogs</a>
            <a href="/dashboard" class="btn btn-primary">Dashboard</a>
            <a href="/logout" class="btn btn-secondary">Đăng xuất</a>
          {{else}}
            <a href="/login" class="btn btn-secondary">Đăng nhập</a>
            <a href="/register" class="btn btn-primary">Đăng ký</a>
          {{/if}}
        </div>
      </div>
    </nav>
  </div>

  <!-- Menu di động (hiển thị khi bấm nút hamburger trên màn hình nhỏ) -->
  <div class="mobile-nav">
    <div class="mobile-nav-header">
      <span class="logo-text">🌈 TVinhhh</span>
      <button class="nav-close-btn" aria-label="Đóng menu">
        <ion-icon name="close-outline"></ion-icon>
      </button>
    </div>

    <ul class="mobile-nav-links">
      <li><a href="/" class="nav-link">Trang chủ</a></li>
      <li><a href="/posts" class="nav-link">Bài viết</a></li>
      <li><a href="/topics" class="nav-link">Chủ đề</a></li>
      <li class="nav-item-contact">
        <button type="button" class="contact-trigger" id="contactTriggerMobile" aria-expanded="false" aria-controls="contactPanelMobile">
          Liên hệ
          <ion-icon name="chevron-down-outline" class="contact-trigger-icon"></ion-icon>
        </button>
        <div class="contact-dropdown contact-dropdown-mobile" id="contactPanelMobile">
          <p class="contact-dropdown-item"><ion-icon name="mail-outline"></ion-icon> thevinh251008@gmail.com</p>
          <p class="contact-dropdown-item"><ion-icon name="call-outline"></ion-icon> 0398857036</p>
          <div class="contact-dropdown-social">
            <a href="#" aria-label="Facebook"><ion-icon name="logo-facebook"></ion-icon></a>
            <a href="#" aria-label="Twitter"><ion-icon name="logo-twitter"></ion-icon></a>
            <a href="#" aria-label="Instagram"><ion-icon name="logo-instagram"></ion-icon></a>
            <a href="#" aria-label="GitHub"><ion-icon name="logo-github"></ion-icon></a>
          </div>
          <a href="/contact" class="contact-dropdown-more">Xem trang liên hệ đầy đủ →</a>
        </div>
      </li>
    </ul>

    <div class="mobile-nav-auth">
      {{#if user}}
        <span class="user-greeting">👋 {{user.fullName}}</span>
        <a href="/dashboard/my-blogs" class="btn btn-secondary">My blogs</a>
        <a href="/dashboard" class="btn btn-primary">Dashboard</a>
        <a href="/logout" class="btn btn-secondary">Đăng xuất</a>
      {{else}}
        <a href="/login" class="btn btn-secondary">Đăng nhập</a>
        <a href="/register" class="btn btn-primary">Đăng ký</a>
      {{/if}}
    </div>
  </div>

  <!-- Lớp phủ tối phía sau menu di động -->
  <div class="mobile-nav-overlay"></div>
</header>
