<!-- ============================================================
     Trang lỗi 404 (Not Found)
     Chức năng: Hiển thị khi user truy cập URL không tồn tại
     ============================================================ -->

<section class="error-section">
  <div class="container">
    <!-- Nội dung lỗi 404 -->
    <div class="error-content">
      <!-- Phần minh họa lỗi (bên trái) -->
      <div class="error-illustration">
        <!-- Số lỗi 404 -->
        <h1 class="error-code">404</h1>
        <!-- Emoji tìm kiếm -->
        <p class="error-emoji">🔍</p>
      </div>
      
      <!-- Phần thông báo lỗi (bên phải) -->
      <div class="error-message">
        <!-- Tiêu đề lỗi -->
        <h2 class="h2">Oops! Trang không tìm thấy</h2>
        <!-- Mô tả lỗi -->
        <p>Xin lỗi, trang bạn tìm kiếm dường như không tồn tại hoặc đã bị xóa.</p>
        
        <!-- Nhóm nút hành động (CTA) -->
        <div class="error-actions">
          <!-- Nút quay lại trang chủ -->
          <a href="/" class="btn btn-primary">← Quay lại trang chủ</a>
          <!-- Nút xem bài viết -->
          <a href="/#blog" class="btn btn-secondary">Xem bài viết</a>
        </div>

        <!-- Hộp tìm kiếm bài viết -->
        <div class="search-box">
          <p>Hoặc bạn có thể tìm kiếm bài viết:</p>
          <!-- Input tìm kiếm (hiệu năng chưa hoạt động, chỉ là UI) -->
          <input type="text" placeholder="Tìm kiếm bài viết..." class="search-input">
        </div>
      </div>
    </div>
  </div>
</section>
